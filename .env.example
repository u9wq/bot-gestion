# ─── Obligatoire ──────────────────────────────────────────────────────────────

# Token du bot — https://discord.com/developers/applications
TOKEN=

# Identifiant du serveur sur lequel le bot doit tourner.
# Le bot quitte automatiquement tout autre serveur : sans cette valeur,
# il quitterait le vôtre au démarrage.
GUILD_ID=

# Identifiants des propriétaires, séparés par des virgules.
# Ils ont accès à toutes les commandes. Sans eux, personne ne peut rien faire.
OWNERS=

# ─── Facultatif ───────────────────────────────────────────────────────────────

# Préfixe des commandes. Par défaut : +
PREFIX=

# Couleur des panneaux, au format #RRGGBB. Par défaut : #ED4245
COLOR=

# Ces variables ne servent qu'au tout premier démarrage : elles créent
# config.json. Ensuite, tout se règle depuis Discord avec +config, +prefix,
# +setcolor et +setfooter.
